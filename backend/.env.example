# --- Base de datos -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/spp_evaluacion
# true = crea las tablas con SQLAlchemy si no existen (solo desarrollo; en producción usa db/schema.sql)
AUTO_CREATE_TABLES=false

# --- CORS (frontend). Varios orígenes separados por coma -----------------------
# Acoplado al monolito el navegador NO llama a este servicio (todo pasa por /api/evaluations del
# monolito), así que en producción déjalo vacío.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Autenticación -----------------------------------------------------------
# dev: confía en los headers X-User-Id y X-User-Role (SOLO desarrollo, sin monolito)
# jwt: valida "Authorization: Bearer <token>" con JWT_SECRET (claims: sub = numDocumento, rol).
#      Es el modo para acoplar al monolito: JWT_SECRET debe ser IGUAL a EVALUATION_SERVICE_SECRET del monolito.
AUTH_MODE=jwt
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- IA ------------------------------------------------------------------------
# auto: Anthropic si hay ANTHROPIC_API_KEY; si no, la API compatible con OpenAI si hay LLM_BASE_URL y
#       LLM_MODEL; si no, el generador simulado
# anthropic | openai_compat | mock
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=8000
MAX_CONTEXT_CHARS=60000
MAX_FILE_MB=15

# --- Servicio de evidencias (integración con el monolito) ------------------------
# stub: datos de ejemplo para pruebas offline (pytest)
# http: consume los endpoints internos del monolito (http://127.0.0.1:3000/api/internal)
EVIDENCIAS_MODE=http
EVIDENCIAS_API_URL=http://127.0.0.1:3000/api/internal
EVIDENCIAS_API_TOKEN=
