# --- Base de datos -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/spp_evaluacion
# true = crea las tablas con SQLAlchemy si no existen (solo desarrollo; en
# producción usa db/schema.sql)
AUTO_CREATE_TABLES=false

# --- CORS (frontend). Varios orígenes separados por coma -----------------------
# Acoplado al monolito el navegador NO llama a este servicio (todo pasa por /api/evaluations del
# monolito), así que en producción déjalo vacío.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Autenticación -----------------------------------------------------------
# dev: confía en los headers X-User-Id y X-User-Role (SOLO desarrollo, sin monolito)
# jwt: valida "Authorization: Bearer <token>" con JWT_SECRET (claims: sub = numDocumento, rol).
#      Es el modo para acoplar al monolito: JWT_SECRET debe ser IGUAL a EVALUATION_SERVICE_SECRET del monolito.
AUTH_MODE=dev
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- IA ------------------------------------------------------------------------
# auto: Anthropic si hay ANTHROPIC_API_KEY; si no, la API compatible con OpenAI si hay LLM_BASE_URL y
#       LLM_MODEL; si no, el generador simulado
# anthropic | openai_compat | mock
LLM_PROVIDER=auto
# IA gratuita (Gemini, Groq, OpenRouter, Ollama...): ver README, «IA real y gratis». Ejemplo con Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=<clave de Google AI Studio>
# LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=8000
MAX_CONTEXT_CHARS=60000
MAX_FILE_MB=15

# --- Servicio de evidencias (otra base de datos / microservicio) ----------------
# stub:        datos de ejemplo (desarrollo)
# practice_db: lee la base de PRÁCTICAS del monolito en SOLO LECTURA (modo para acoplar al monolito)
# http:        consume otra API (contrato en app/services/evidencias_client.py)
EVIDENCIAS_MODE=stub
# practice_db: mismo servidor/base que DATABASE_URL_PRACTICE del monolito, de preferencia con un usuario que
# solo tenga SELECT en actividad, evidenciaactividad, evidenciaarchivo y archivosactividad
PRACTICE_DATABASE_URL=
# Dominios desde los que se descargan los archivos de evidencia (separados por coma)
ALLOWED_FILE_HOSTS=res.cloudinary.com
EVIDENCIAS_API_URL=
EVIDENCIAS_API_TOKEN=
